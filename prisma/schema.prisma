generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTHENTICATION & USERS
// ============================================================

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  hashedPassword String
  role           UserRole  @default(LAWYER)
  phone          String?
  licenseNumber  String?   // Nr. license avokati
  barAssociation String?   // Dhoma e Avokatisë
  avatar         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  cases          Case[]
  clients        Client[]
  documents      Document[]
  events         CalendarEvent[]
  timeEntries    TimeEntry[]
  savedDecisions SavedDecision[]
  ropaEntries    RopaEntry[]
  dataBreaches   DataBreach[]
  dsarRequests   DsarRequest[]
  dpias          Dpia[]

  @@map("users")
}

enum UserRole {
  ADMIN
  LAWYER
  PARALEGAL
  SECRETARY
}

// ============================================================
// CLIENT MANAGEMENT
// ============================================================

model Client {
  id          String     @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  address     String?
  city        String?
  nuis        String?    // NUIS / Tax ID for businesses
  type        ClientType @default(INDIVIDUAL)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userId      String
  user        User       @relation(fields: [userId], references: [id])
  cases       CaseClient[]
  ropaEntries RopaEntry[]
  dataBreaches DataBreach[]
  dsarRequests DsarRequest[]
  dpias       Dpia[]

  @@map("clients")
}

enum ClientType {
  INDIVIDUAL
  BUSINESS
  GOVERNMENT
}

// ============================================================
// CASE MANAGEMENT
// ============================================================

model Case {
  id            String     @id @default(cuid())
  caseNumber    String?    // Nr. çështjes gjyqësore
  title         String
  description   String?
  status        CaseStatus @default(OPEN)
  priority      Priority   @default(MEDIUM)
  caseType      CaseType
  courtName     String?    // Emri i gjykatës
  courtCaseId   String?    // Nr. çështjes në gjykatë
  judge         String?    // Gjyqtari
  opposingParty String?    // Pala kundërshtare
  opposingLawyer String?   // Avokati i palës kundërshtare
  openedAt      DateTime   @default(now())
  closedAt      DateTime?
  nextHearing   DateTime?  // Data e seancës së ardhshme
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  userId        String
  user          User       @relation(fields: [userId], references: [id])

  clients       CaseClient[]
  documents     Document[]
  events        CalendarEvent[]
  timeEntries   TimeEntry[]
  caseNotes     CaseNote[]

  @@map("cases")
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  HEARING_SCHEDULED
  AWAITING_DECISION
  APPEALED
  CLOSED_WON
  CLOSED_LOST
  CLOSED_SETTLED
  ARCHIVED
}

enum CaseType {
  CIVIL
  CRIMINAL
  ADMINISTRATIVE
  CONSTITUTIONAL
  COMMERCIAL
  FAMILY
  LABOR
  PROPERTY
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Junction table for Case-Client many-to-many
model CaseClient {
  id        String         @id @default(cuid())
  role      CaseClientRole @default(CLIENT)
  caseId    String
  case      Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client         @relation(fields: [clientId], references: [id])

  @@unique([caseId, clientId])
  @@map("case_clients")
}

enum CaseClientRole {
  CLIENT
  PLAINTIFF
  DEFENDANT
  WITNESS
  THIRD_PARTY
}

model CaseNote {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("case_notes")
}

// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id          String       @id @default(cuid())
  title       String
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  category    DocumentCategory @default(OTHER)
  createdAt   DateTime     @default(now())

  userId      String
  user        User         @relation(fields: [userId], references: [id])
  caseId      String?
  case        Case?        @relation(fields: [caseId], references: [id])

  @@map("documents")
}

enum DocumentCategory {
  CONTRACT
  COURT_FILING
  EVIDENCE
  CORRESPONDENCE
  POWER_OF_ATTORNEY
  DECISION
  APPEAL
  OTHER
}

// ============================================================
// CALENDAR & EVENTS
// ============================================================

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  location    String?
  eventType   EventType @default(MEETING)
  reminder    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id])
  caseId      String?
  case        Case?     @relation(fields: [caseId], references: [id])

  @@map("calendar_events")
}

enum EventType {
  HEARING       // Seancë gjyqësore
  MEETING       // Takim
  DEADLINE      // Afat
  CONSULTATION  // Konsultë
  FILING        // Dorëzim dokumenti
  OTHER
}

// ============================================================
// TIME TRACKING & BILLING
// ============================================================

model TimeEntry {
  id          String   @id @default(cuid())
  description String
  hours       Float
  date        DateTime
  billable    Boolean  @default(true)
  rate        Float?   // Tarifa për orë
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id])
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id])

  @@map("time_entries")
}

// ============================================================
// COURT DECISIONS (from scraped data)
// ============================================================

model CourtDecision {
  id            String       @id @default(cuid())
  decisionNumber String?     // Nr. vendimit
  caseNumber    String?      // Nr. çështjes
  court         CourtSource
  college       String?      // Kolegji (Civil, Penal, Administrativ)
  decisionType  String?      // Tip vendimi
  decisionDate  DateTime?
  parties       String?      // Palët (anonimizuar)
  subject       String?      // Objekti
  summary       String?      // Përmbledhje
  fullText      String?      // Teksti i plotë
  pdfUrl        String?      // Link PDF origjinal
  sourceUrl     String       // URL origjinale
  scrapedAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  savedBy       SavedDecision[]

  @@index([court, decisionDate])
  @@index([college])
  @@map("court_decisions")
}

enum CourtSource {
  GJYKATA_LARTE        // Gjykata e Lartë
  GJYKATA_KUSHTETUESE  // Gjykata Kushtetuese
  GJYKATA_APELIT       // Gjykata e Apelit
  GJYKATA_RRETHIT      // Gjykata e Rrethit
  GJYKATA_ADMINISTRATIVE // Gjykata Administrative
}

// Saved decisions per user (bookmarks)
model SavedDecision {
  id         String   @id @default(cuid())
  notes      String?
  savedAt    DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])
  decisionId String
  decision   CourtDecision @relation(fields: [decisionId], references: [id])

  @@unique([userId, decisionId])
  @@map("saved_decisions")
}

// ============================================================
// SCRAPING LOG
// ============================================================

model ScrapeLog {
  id         String      @id @default(cuid())
  source     CourtSource
  status     ScrapeStatus
  itemsFound Int         @default(0)
  itemsNew   Int         @default(0)
  error      String?
  startedAt  DateTime    @default(now())
  finishedAt DateTime?

  @@map("scrape_logs")
}

enum ScrapeStatus {
  RUNNING
  SUCCESS
  FAILED
}

// ============================================================
// DPO SUITE — Privacy & Data Protection (Ligji 124/2024, GDPR)
// ============================================================

// Regjistri i Aktiviteteve të Përpunimit (RoPA)
model RopaEntry {
  id               String        @id @default(cuid())
  name             String        // Emri i aktivitetit të përpunimit
  department       String?       // Departamenti / funksioni përgjegjës
  purpose          String        // Qëllimi i përpunimit
  legalBasis       LegalBasis    @default(CONTRACT)
  dataCategories   String?       // Kategoritë e të dhënave
  dataSubjects     String?       // Kategoritë e subjekteve
  recipients       String?       // Marrësit e të dhënave
  transfers        String?       // Transferime ndërkombëtare (vende të treta)
  retention        String?       // Afati i ruajtjes
  securityMeasures String?       // Masat teknike dhe organizative
  status           RopaStatus    @default(ACTIVE)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  userId           String
  user             User          @relation(fields: [userId], references: [id])
  clientId         String?       // Kontrolluesi (klienti) të cilit i përket
  client           Client?       @relation(fields: [clientId], references: [id])

  @@index([userId, status])
  @@map("ropa_entries")
}

enum LegalBasis {
  CONSENT              // Pëlqimi
  CONTRACT             // Ekzekutimi i kontratës
  LEGAL_OBLIGATION     // Detyrim ligjor
  VITAL_INTEREST       // Interes jetik
  PUBLIC_INTEREST      // Interes publik
  LEGITIMATE_INTEREST  // Interes legjitim
}

enum RopaStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Regjistri i Incidenteve të Sigurisë (Data Breach)
model DataBreach {
  id                 String         @id @default(cuid())
  title              String
  description        String?
  occurredAt         DateTime?      // Kur ka ndodhur incidenti
  discoveredAt       DateTime       // Kur është zbuluar (fillon afati 72h)
  notifiedAuthorityAt DateTime?     // Njoftimi i Komisionerit
  notifiedSubjectsAt DateTime?      // Njoftimi i subjekteve
  severity           BreachSeverity @default(MEDIUM)
  status             BreachStatus   @default(DETECTED)
  affectedSubjects   Int?           // Numri i subjekteve të prekur
  dataCategories     String?        // Kategoritë e të dhënave të prekura
  measures           String?        // Masat e marra
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  userId             String
  user               User           @relation(fields: [userId], references: [id])
  clientId           String?
  client             Client?        @relation(fields: [clientId], references: [id])

  @@index([userId, status])
  @@map("data_breaches")
}

enum BreachSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BreachStatus {
  DETECTED       // I zbuluar
  INVESTIGATING  // Në hetim
  CONTAINED      // I izoluar
  NOTIFIED       // Autoriteti i njoftuar
  CLOSED         // I mbyllur
}

// Regjistri i Kërkesave të Subjekteve (DSAR)
model DsarRequest {
  id           String      @id @default(cuid())
  subjectName  String      // Emri i subjektit të të dhënave
  subjectEmail String?
  type         DsarType    @default(ACCESS)
  receivedAt   DateTime    // Data e marrjes (fillon afati 30-ditor)
  dueDate      DateTime    // Afati i përgjigjes
  completedAt  DateTime?
  status       DsarStatus  @default(RECEIVED)
  description  String?
  response     String?     // Përmbledhje e përgjigjes
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  userId       String
  user         User        @relation(fields: [userId], references: [id])
  clientId     String?
  client       Client?     @relation(fields: [clientId], references: [id])

  @@index([userId, status])
  @@map("dsar_requests")
}

enum DsarType {
  ACCESS         // E drejta e aksesit
  RECTIFICATION  // Korrigjim
  ERASURE        // Fshirje
  RESTRICTION    // Kufizim përpunimi
  PORTABILITY    // Portabilitet
  OBJECTION      // Kundërshtim
}

enum DsarStatus {
  RECEIVED
  IN_PROGRESS
  EXTENDED     // Afat i zgjatur
  COMPLETED
  REJECTED
}

// Vlerësimi i Ndikimit në Mbrojtjen e të Dhënave (DPIA)
model Dpia {
  id                 String     @id @default(cuid())
  title              String
  processName        String?    // Përpunimi që vlerësohet
  description        String?
  riskLevel          DpiaRisk   @default(MEDIUM)
  status             DpiaStatus @default(DRAFT)
  mitigations        String?    // Masat zbutëse
  consultedAuthority Boolean    @default(false) // Konsultim paraprak me Komisionerin
  startedAt          DateTime   @default(now())
  completedAt        DateTime?
  reviewDate         DateTime?  // Data e rishikimit të radhës
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  userId             String
  user               User       @relation(fields: [userId], references: [id])
  clientId           String?
  client             Client?    @relation(fields: [clientId], references: [id])

  @@index([userId, status])
  @@map("dpias")
}

enum DpiaRisk {
  LOW
  MEDIUM
  HIGH
}

enum DpiaStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  REVIEW_NEEDED
}
